    {
      "parameters": {
        "jsCode": "const incoming = $json.body ?? $json;\nconst jobId = incoming.jobId || ('cf-' + Date.now());\nconst product = incoming.product || incoming.productName || {};\nconst productName = typeof product === 'string'\n  ? product\n  : (product.name || incoming.productName || 'Товар');\n\nconst job = {\n  jobId,\n  receivedAt: new Date().toISOString(),\n  action: incoming.action || 'create_content',\n  productId: incoming.productId || product.id || null,\n  productName,\n  platforms: incoming.platforms || ['TikTok','Reels','Shorts'],\n  variants: incoming.variants || incoming.count || 1,\n  media: incoming.media || product.media || [],\n  payload: incoming\n};\n\nreturn [{\n  json: {\n    ...job,\n    fileName: jobId + ' — ' + productName.replace(/[\\\\/:*?\"<>|]/g,'_') + '.json',\n    fileContent: JSON.stringify(job, null, 2)\n  }\n}];"
      },
      "id": "34d9a176-64ab-4a90-b5da-cc4808dd5b84",
      "name": "Подготовить задачу",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ]
    },
    {
